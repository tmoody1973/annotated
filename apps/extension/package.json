{
  "name": "extension",
  "displayName": "Annotated",
  "version": "0.4.0",
  "description": "Clip and annotate media from any web page \u2014 YouTube, podcasts, articles.",
  "author": "Tarik Moody <tarik@radiomilwaukee.org>",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package:store": "node scripts/package-store.mjs"
  },
  "dependencies": {
    "@annotated/shared": "workspace:*",
    "@heroui/react": "^3.0.5",
    "@heroui/styles": "^3.0.5",
    "convex": "^1.39.1",
    "plasmo": "^0.90.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^20.12.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7"
  },
  "manifest": {
    "key": "$CRX_PUBLIC_KEY",
    "host_permissions": [
      "https://*/*"
    ],
    "permissions": [
      "sidePanel",
      "storage",
      "activeTab",
      "scripting"
    ],
    "side_panel": {
      "default_path": "sidepanel.html"
    }
  }
}
